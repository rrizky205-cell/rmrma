# ===================================================================
# TATADANA ENVIRONMENT CONFIGURATION
# ===================================================================

# App & Deployment Base URL (digunakan untuk webhook Telegram)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WEBHOOK_BASE_URL="http://localhost:3000"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_from_botfather"

# Supabase (Postgres & Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="tatadana-exports"

# AI Providers (Multi-provider fallback & failover)
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEFAULT_AI_PROVIDER="gemini" # gemini | openai | deepseek
AI_MODE="parallel" # single | parallel (failover)

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# Security & Encryption for Stored Bot Tokens / Credentials
ENCRYPTION_SECRET="super-secret-key-32-chars-long-tatadana-fintech"
